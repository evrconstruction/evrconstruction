rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'contact@evrconstructions.com';
    }

    // Public read for project images, admin upload/delete
    match /posts/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
